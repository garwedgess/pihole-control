CREATE TRIGGER IF NOT EXISTS change_to_not_active_on_update
BEFORE UPDATE OF Active ON Connection
WHEN new.Active = 1
BEGIN
    UPDATE Connection
    SET Active = 0
    WHERE Active = 1 AND Id <> new.Id;
END;


CREATE TRIGGER IF NOT EXISTS change_to_not_active_on_insert
BEFORE INSERT ON Connection
BEGIN
    UPDATE Connection
    SET Active = 0
    WHERE Active = 1;
END;

CREATE TRIGGER IF NOT EXISTS next_connection_active_on_delete
AFTER DELETE ON Connection
WHEN old.Active = 1
BEGIN
    -- Deactivate all connections
    UPDATE Connection
    SET Active = 0;

    -- Attempt to activate the next available inactive connection in Connection
    UPDATE Connection
    SET Active = 1
    WHERE Id = (
        SELECT Id
        FROM Connection
        WHERE IsDeleted = 0 AND Active = 0
        LIMIT 1
    );
END;



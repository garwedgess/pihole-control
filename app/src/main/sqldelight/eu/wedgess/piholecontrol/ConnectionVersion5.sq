import io.ktor.http.URLProtocol;
import java.util.UUID;
import kotlin.Boolean;
import kotlin.Int;

CREATE TABLE ConnectionVersion5(
    Id TEXT AS UUID PRIMARY KEY NOT NULL,
    Name TEXT NOT NULL,
    Protocol TEXT AS URLProtocol NOT NULL,
    Host TEXT NOT NULL,
    ApiPath TEXT NOT NULL,
    Port INTEGER AS Int NOT NULL,
    Token TEXT,
    AuthUserName TEXT NOT NULL DEFAULT "",
    AuthPassword TEXT NOT NULL DEFAULT "",
    AuthRealm TEXT NOT NULL DEFAULT "",
    TrustAllCerts INTEGER AS Boolean NOT NULL DEFAULT 0,
    IsDeleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    Active INTEGER AS Boolean NOT NULL DEFAULT 0
);

insert:
INSERT OR FAIL INTO ConnectionVersion5(Id, Name, Protocol, Host, ApiPath, Port, Token, AuthUserName, AuthPassword, AuthRealm, TrustAllCerts, IsDeleted, Active)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM ConnectionVersion5;

exists:
SELECT EXISTS(SELECT 1 FROM ConnectionVersion5 WHERE Id = ?);

delete:
DELETE FROM ConnectionVersion5 WHERE Id = :id;

markAsDeleted:
UPDATE ConnectionVersion5
SET IsDeleted = 1
WHERE Id = :id;

unmarkAsDeleted:
UPDATE ConnectionVersion5
SET IsDeleted = 0
WHERE Id = :id;

deleteAllMarkedAsDeleted:
DELETE FROM ConnectionVersion5
WHERE IsDeleted = 1;

update:
UPDATE ConnectionVersion5
SET Name = :name,
Protocol = :protocol,
Host = :host,
ApiPath = :path,
Port = :port,
Token = :token,
AuthUserName = :username,
AuthPassword = :password,
TrustAllCerts = :trustAllCerts,
AuthRealm = :realm
WHERE Id = :id;

updateAsActive:
UPDATE ConnectionVersion5
SET Active = 1
WHERE Id = :id;

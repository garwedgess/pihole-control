CREATE VIEW Connection AS
SELECT
    Id,
    Name,
    Protocol,
    Host,
    ApiPath,
    Port,
    Token,
    NULL AS Password,
    NULL AS Sid,
    AuthUserName,
    AuthPassword,
    AuthRealm,
    TrustAllCerts,
    IsDeleted,
    Active,
    1 AS ApiVersion
FROM ConnectionVersion5
UNION ALL
SELECT
    Id,
    Name,
    Protocol,
    Host,
    NULL AS ApiPath,
    Port,
    NULL AS Token,
    Password,
    Sid,
    AuthUserName,
    AuthPassword,
    AuthRealm,
    TrustAllCerts,
    IsDeleted,
    Active,
    2 AS ApiVersion
FROM ConnectionVersion6;

selectAll:
SELECT * FROM Connection WHERE IsDeleted = 0;

selectById:
SELECT * FROM Connection WHERE Id = :id;

selectActive:
SELECT * FROM Connection WHERE Active = 1;

checkNotEmpty:
SELECT COUNT(*) != 0 FROM Connection;

dummySelect:
SELECT * FROM ConnectionVersion6;

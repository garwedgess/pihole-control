import io.ktor.http.URLProtocol;
import java.util.UUID;
import kotlin.Boolean;
import kotlin.Int;

CREATE TABLE Connection(
    Id TEXT AS UUID PRIMARY KEY NOT NULL,
    Name TEXT NOT NULL,
    Protocol TEXT AS URLProtocol NOT NULL,
    Host TEXT NOT NULL,
    Port INTEGER AS Int NOT NULL,
    Password TEXT NOT NULL,
    ApiPath TEXT NOT NULL DEFAULT "/api",
    Sid TEXT NOT NULL DEFAULT "",
    AuthUserName TEXT NOT NULL DEFAULT "",
    AuthPassword TEXT NOT NULL DEFAULT "",
    AuthRealm TEXT NOT NULL DEFAULT "",
    TrustAllCerts INTEGER AS Boolean NOT NULL DEFAULT 0,
    IsDeleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    Active INTEGER AS Boolean NOT NULL DEFAULT 0
);

insert:
INSERT OR FAIL INTO Connection (Id, Name, Protocol, Host, Port, Password, ApiPath, Sid, AuthUserName, AuthPassword, AuthRealm, TrustAllCerts, IsDeleted, Active)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM Connection;

selectActive:
SELECT * FROM Connection WHERE Active = 1;

selectById:
SELECT * FROM Connection WHERE Id = :id;

exists:
SELECT EXISTS(SELECT 1 FROM Connection WHERE Id = ?);

checkNotEmpty:
SELECT COUNT(*) != 0 FROM Connection;

delete:
DELETE FROM Connection WHERE Id = :id;

markAsDeleted:
UPDATE Connection
SET IsDeleted = 1
WHERE Id = :id;

unmarkAsDeleted:
UPDATE Connection
SET IsDeleted = 0
WHERE Id = :id;

deleteAllMarkedAsDeleted:
DELETE FROM Connection
WHERE IsDeleted = 1;

update:
UPDATE Connection
SET Name = :name,
Protocol = :protocol,
Host = :host,
Port = :port,
Password = :password,
ApiPath = :apiPath,
Sid = :sid,
AuthUserName = :authUsername,
AuthPassword = :authPassword,
TrustAllCerts = :trustAllCerts,
AuthRealm = :realm
WHERE Id = :id;

updateAsActive:
UPDATE Connection
SET Active = 1
WHERE Id = :id;

import io.ktor.http.URLProtocol;
import kotlin.Boolean;
import kotlin.Int;

CREATE TABLE Connection(
 Id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
 Name TEXT NOT NULL,
 Protocol TEXT AS URLProtocol NOT NULL,
 Host TEXT NOT NULL,
 ApiPath TEXT NOT NULL,
 Port INTEGER AS Int NOT NULL,
 Token TEXT,
 AuthUserName TEXT NOT NULL DEFAULT "",
 AuthPassword TEXT NOT NULL DEFAULT "",
 AuthRealm TEXT NOT NULL DEFAULT "",
 TrustAllCerts INTEGER AS Boolean NOT NULL DEFAULT 0,
 Active INTEGER AS Boolean NOT NULL DEFAULT 0
);

insert:
INSERT OR FAIL INTO Connection (Name, Protocol, Host, ApiPath, Port, Token, AuthUserName, AuthPassword, AuthRealm, TrustAllCerts, Active)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

checkNotEmpty:
SELECT COUNT(*) != 0 FROM Connection;

selectAll:
SELECT * FROM Connection;

selectById:
SELECT * FROM Connection
WHERE Id = :id;

selectActive:
SELECT * FROM Connection
WHERE Active = 1;

delete:
DELETE FROM Connection WHERE Id = :id;

update:
UPDATE Connection
SET Name = :name,
Protocol = :protocol,
Host = :host,
ApiPath = :path,
Port = :port,
Token = :token,
AuthUserName = :username,
AuthPassword = :password,
TrustAllCerts = :trustAllCerts,
AuthRealm = :realm
WHERE Id = :id;

updateAsActive:
UPDATE Connection
SET Active = 1
WHERE Id = :id;

CREATE TRIGGER IF NOT EXISTS change_to_not_active_on_update
BEFORE UPDATE OF Active ON Connection
BEGIN
  UPDATE Connection
  SET Active = 0
  WHERE Connection.Id <> new.Id;
END;

CREATE TRIGGER IF NOT EXISTS change_to_not_active_on_insert
BEFORE INSERT ON Connection
BEGIN
  UPDATE Connection
  SET Active = 0;
END;


import io.ktor.http.URLProtocol;
import java.util.UUID;
import kotlin.Boolean;
import kotlin.Int;

CREATE TABLE ConnectionVersion6(
    Id TEXT AS UUID PRIMARY KEY NOT NULL,
    Name TEXT NOT NULL,
    Protocol TEXT AS URLProtocol NOT NULL,
    Host TEXT NOT NULL,
    Port INTEGER AS Int NOT NULL,
    Password TEXT NOT NULL,
    Sid TEXT NOT NULL DEFAULT "",
    AuthUserName TEXT NOT NULL DEFAULT "",
    AuthPassword TEXT NOT NULL DEFAULT "",
    AuthRealm TEXT NOT NULL DEFAULT "",
    TrustAllCerts INTEGER AS Boolean NOT NULL DEFAULT 0,
    IsDeleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    Active INTEGER AS Boolean NOT NULL DEFAULT 0
);

insert:
INSERT OR FAIL INTO ConnectionVersion6 (Id, Name, Protocol, Host, Port, Password, Sid, AuthUserName, AuthPassword, AuthRealm, TrustAllCerts, IsDeleted, Active)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM ConnectionVersion6;

exists:
SELECT EXISTS(SELECT 1 FROM ConnectionVersion6 WHERE Id = ?);

delete:
DELETE FROM ConnectionVersion6 WHERE Id = :id;

markAsDeleted:
UPDATE ConnectionVersion6
SET IsDeleted = 1
WHERE Id = :id;

unmarkAsDeleted:
UPDATE ConnectionVersion6
SET IsDeleted = 0
WHERE Id = :id;

deleteAllMarkedAsDeleted:
DELETE FROM ConnectionVersion6
WHERE IsDeleted = 1;

update:
UPDATE ConnectionVersion6
SET Name = :name,
Protocol = :protocol,
Host = :host,
Port = :port,
Password = :password,
Sid = :sid,
AuthUserName = :authUsername,
AuthPassword = :authPassword,
TrustAllCerts = :trustAllCerts,
AuthRealm = :realm
WHERE Id = :id;

updateAsActive:
UPDATE ConnectionVersion6
SET Active = 1
WHERE Id = :id;

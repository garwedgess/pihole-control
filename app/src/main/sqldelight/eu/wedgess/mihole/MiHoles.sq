import io.ktor.http.URLProtocol;
import kotlin.Boolean;
import kotlin.Int;

CREATE TABLE MiHoles(
 Id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
 Name TEXT NOT NULL,
 Protocol TEXT AS URLProtocol NOT NULL,
 Host TEXT NOT NULL,
 ApiPath TEXT NOT NULL,
 Port INTEGER AS Int NOT NULL,
 Token TEXT,
 AuthUserName TEXT NOT NULL DEFAULT "",
 AuthPassword TEXT NOT NULL DEFAULT "",
 AuthRealm TEXT NOT NULL DEFAULT "",
 Active INTEGER AS Boolean NOT NULL DEFAULT 0
);

insert:
INSERT OR FAIL INTO MiHoles
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM MiHoles;

selectById:
SELECT * FROM MiHoles
WHERE Id = :id;

selectActive:
SELECT * FROM MiHoles
WHERE Active = 1;

delete:
DELETE FROM MiHoles WHERE Id = :id;

update:
UPDATE MiHoles
SET Name = :name,
Protocol = :protocol,
Host = :host,
ApiPath = :path,
Port = :port,
Token = :token,
AuthUserName = :username,
AuthPassword = :password,
AuthRealm = :realm
WHERE Id = :id;

updateAsActive:
UPDATE MiHoles
SET Active = 1
WHERE Id = :id;

CREATE TRIGGER IF NOT EXISTS change_to_not_active
AFTER UPDATE OF Active ON MiHoles
BEGIN
  UPDATE MiHoles
  SET Active = 0
  WHERE MiHoles.Id <> new.Id;
END;


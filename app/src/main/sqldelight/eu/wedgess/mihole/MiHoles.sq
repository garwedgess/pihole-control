import io.ktor.http.URLProtocol;
import kotlin.Boolean;
import kotlin.Int;

CREATE TABLE MiHoles(
 Id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
 Name TEXT NOT NULL,
 Protocol TEXT AS URLProtocol NOT NULL,
 Host TEXT NOT NULL,
 ApiPath TEXT NOT NULL,
 Port INTEGER AS Int NOT NULL,
 Token TEXT,
 AuthUserName TEXT NOT NULL DEFAULT "",
 AuthPassword TEXT NOT NULL DEFAULT "",
 AuthRealm TEXT NOT NULL DEFAULT "",
 TrustAllCerts INTEGER AS Boolean NOT NULL DEFAULT 0,
 Active INTEGER AS Boolean NOT NULL DEFAULT 0
);

insert:
INSERT OR FAIL INTO MiHoles (Name, Protocol, Host, ApiPath, Port, Token, AuthUserName, AuthPassword, AuthRealm, TrustAllCerts, Active)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM MiHoles;

selectById:
SELECT * FROM MiHoles
WHERE Id = :id;

selectActive:
SELECT * FROM MiHoles
WHERE Active = 1;

delete:
DELETE FROM MiHoles WHERE Id = :id;

update:
UPDATE MiHoles
SET Name = :name,
Protocol = :protocol,
Host = :host,
ApiPath = :path,
Port = :port,
Token = :token,
AuthUserName = :username,
AuthPassword = :password,
TrustAllCerts = :trustAllCerts,
AuthRealm = :realm
WHERE Id = :id;

updateAsActive:
UPDATE MiHoles
SET Active = 1
WHERE Id = :id;

CREATE TRIGGER IF NOT EXISTS change_to_not_active_on_update
BEFORE UPDATE OF Active ON MiHoles
BEGIN
  UPDATE MiHoles
  SET Active = 0
  WHERE MiHoles.Id <> new.Id;
END;

CREATE TRIGGER IF NOT EXISTS change_to_not_active_on_insert
BEFORE INSERT ON MiHoles
BEGIN
  UPDATE MiHoles
  SET Active = 0;
END;

